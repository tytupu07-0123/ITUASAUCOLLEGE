@model IEnumerable<ITU_ASAU_COLLEGE.Models.EnrollmentApplication>

@{
    ViewData["Title"] = "Incoming Enrolment Applications";
}

<div class="container mt-4">

    <div class="text-center mb-4">

        <h1>Incoming Enrolment Applications</h1>

        <p class="lead">
            Review applications submitted by prospective students.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            There are currently no enrolment applications.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Applicant</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Year Level</th>
                        <th>Application Date</th>
                        <th>Courses</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var application in Model)
                    {
                        <tr>

                            <td>
                                @application.FirstName
                                @application.LastName
                            </td>

                            <td>
                                @application.Email
                            </td>

                            <td>
                                @application.PhoneNumber
                            </td>

                            <td>
                                @application.YearLevel
                            </td>

                            <td>
                                @application.ApplicationDate.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @application.Courses
                            </td>

                            <td>

                                @if (application.Status ==
                                                        ITU_ASAU_COLLEGE.Models.ApplicationStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (application.Status ==
                                                         ITU_ASAU_COLLEGE.Models.ApplicationStatus.Accepted)
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }

                            </td>

                            <td>

                                @if (application.Status ==
                                                         ITU_ASAU_COLLEGE.Models.ApplicationStatus.Pending)
                                {
                                    <form asp-action="Accept"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@application.EnrollmentApplicationId" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Accept
                                        </button>

                                    </form>

                                    <form asp-action="Reject"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@application.EnrollmentApplicationId" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Reject
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No action available
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>