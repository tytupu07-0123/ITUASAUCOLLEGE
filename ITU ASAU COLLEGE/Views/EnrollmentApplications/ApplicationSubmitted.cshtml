@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container mt-5">

    <div class="card shadow text-center p-5">

        <h1 class="text-success">
            Application Submitted
        </h1>

        <p class="lead mt-3">
            Thank you for applying to ITU ASAU COLLEGE.
        </p>

        <p>
            Your enrolment application has been successfully submitted.
            The school administration will review your application.
        </p>

        <p>
            Please wait for the school to contact you regarding the outcome
            of your application.
        </p>

        <div class="mt-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary">
                Return to Home
            </a>

        </div>

    </div>

</div>
