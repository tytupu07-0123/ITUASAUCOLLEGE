@model ITU_ASAU_COLLEGE.Models.Enrollment

@{
    ViewData["Title"] = "Create Enrollment";
}

<h1>Create Enrollment</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <!-- Student Dropdown -->
            <div class="form-group mb-3">
                <label asp-for="StudentId"
                       class="control-label">
                    Student
                </label>

                <select asp-for="StudentId"
                        class="form-control"
                        asp-items="ViewBag.Students">

                    <option value="">
                        -- Select Student --
                    </option>

                </select>

                <span asp-validation-for="StudentId"
                      class="text-danger">
                </span>
            </div>

            <!-- Course Name -->
            <div class="form-group mb-3">
                <label asp-for="CourseName"
                       class="control-label">
                </label>

                <select asp-for="CourseName"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<ITU_ASAU_COLLEGE.Models.CourseName>()">

                    <option value="">
                        -- Select Course --
                    </option>

                </select>

                <span asp-validation-for="CourseName"
                      class="text-danger">
                </span>
            </div>

            <!-- Enrollment Date -->
            <div class="form-group mb-3">
                <label asp-for="EnrollmentDate"
                       class="control-label">
                </label>

                <input asp-for="EnrollmentDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="EnrollmentDate"
                      class="text-danger">
                </span>
            </div>

            <!-- Submit -->
            <div class="form-group">
                <input type="submit"
                       value="Create"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}