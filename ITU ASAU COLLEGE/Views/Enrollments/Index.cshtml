@model IEnumerable<ITU_ASAU_COLLEGE.Models.Enrollment>

@{
    ViewData["Title"] = "Index";
}
<style>
    .body {
        background-color:aliceblue;
    }
    .table {
        background-color: white;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px; 

    }
</style>
<h1>Enrollments</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EnrollmentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseName)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.EnrollmentDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.CourseName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EnrollmentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EnrollmentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EnrollmentId">Delete</a> |
            </td>
        </tr>
}
    </tbody>
</table>
