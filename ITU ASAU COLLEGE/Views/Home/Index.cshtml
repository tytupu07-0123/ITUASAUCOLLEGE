@{
    ViewData["Title"] = "Home Page";
}


<div class="text-center">
    <h1 class="display-4" style="text-align: center;">WELCOME</h1>
</div>
<style>
    h1 {
        text-align: center;
        color:black;
        font-size:100px;
        text-shadow: 2px 2px;
        font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif, algerian;
    }
</style>
<div class="container mt-5">
    <div class="row justify-content-center">

        <!-- Mission -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="info-card">
                <h1>Mission</h1>

                <p>
                    To provide accessible, high-quality education that empowers
                    students with knowledge, practical skills, ethical values,
                    and leadership abilities, preparing them to contribute
                    meaningfully to the development of Samoa and the global
                    community.
                </p>
            </div>
        </div>

        <!-- Vision -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="info-card">
                <h1>Vision</h1>

                <p>
                    To be a leading institution of higher learning in Samoa,
                    recognized for academic excellence, innovation, cultural
                    preservation, and the development of graduates who are
                    competent, compassionate, and globally competitive.
                </p>
            </div>
        </div>

        <!-- Values -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="info-card">
                <h1>Values</h1>

                <ul>
                    <li><strong>A</strong> – Accountability</li>
                    <li><strong>E</strong> – Excellence</li>
                    <li><strong>I</strong> – Integrity</li>
                    <li><strong>R</strong> – Respect</li>
                    <li><strong>S</strong> – Service</li>
                    <li><strong>L</strong> – Leadership</li>
                    <li><strong>I</strong> – Innovation</li>
                    <li><strong>C</strong> – Collaboration</li>
                </ul>
            </div>
        </div>

    </div>
</div>
<style>
    .row{
        display: flex;
        align-items: stretch;
    }
    .info-card{
        height:100%;
    }
</style>

