@{
    ViewData["Title"] = "Home Page";
}
<style>
    body {
        background-image: url('images/background.png');
        background-size: auto;
        background-repeat: no-repeat;
    }
</style>

<div class="text-center">
    <h1 class="display-4" style="text-align: center;">WELCOME</h1>
    <p><i>Welcome to Itu Asau College, a place of inspiration, motivation, and learning. Inspiring excellence, innovation, and long life success</i></p>
</div>
<style>
    h1 {
        text-align: center;
        color:black;
        font-size:100px;
        text-shadow: 2px 2px;
        font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif, algerian;
    }
    p{
        text-align:center;
        color: deepskyblue;
        font-size:20px;
        font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif, 'Times New Roman', Times, serif ;
    }
</style>


<div class="text-left">
    <h2 class="display-1" style="text-align: left;">Mission</h2>
    <p>To provide quality education and foster the holistic development of students in a supportive and inclusive environment. To be a leading institution in academic excellence, empowering students with knowledge, skills, and values to become innovative, respinsible, and successful contributors to their community and the world.</p>
    <h3 class="display-1" style="text-align: left;">Vision</h3>
    <p>ITU ASAU COLLEGE is committed to providing high-quality education through effective teaching, practical  learning experiences, and a supportive environment that fosters academic achievement, personal growth, leadership, and long life learning</p>
