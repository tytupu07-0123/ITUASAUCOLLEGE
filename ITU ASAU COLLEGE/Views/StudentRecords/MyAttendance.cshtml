@model IEnumerable<ITU_ASAU_COLLEGE.Models.Attendance>

@{
    ViewData["Title"] = "My Attendance";
}

<link rel="stylesheet" href="~/css/student-records.css" />

<div class="student-records-page">

    <div class="student-page-header">
        <div>
            <h1>My Attendance</h1>
            <p>View your personal attendance history.</p>
        </div>

        <a asp-controller="StudentsDashboard"
           asp-action="Index"
           class="back-button">
            ← Dashboard
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="records-card">

            <div class="records-card-header">
                <div>
                    <h2>Attendance History</h2>
                    <p>Your recorded attendance</p>
                </div>

                <span class="record-count">
                    @Model.Count() Records
                </span>
            </div>

            <div class="table-container">

                <table class="student-records-table">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Class</th>
                            <th>Attendance Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var attendance in Model)
                        {
                            <tr>
                                <td>
                                    @attendance.Date.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(attendance.Subject ?? "Not specified")
                                </td>

                                <td>
                                    @(attendance.ClassName ?? "Not specified")
                                </td>

                                <td>
                                    @if (attendance.IsPresent)
                                    {
                                        <span class="status-badge present">
                                            Present
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge absent">
                                            Absent
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="empty-records">
            <div class="empty-icon">📅</div>

            <h2>No Attendance Records</h2>

            <p>
                Your attendance has not been recorded yet.
            </p>
        </div>
    }

</div>
