@model IEnumerable<ITU_ASAU_COLLEGE.Models.Student>

@{
    ViewData["Title"] = "Index";
}
<style>
    .body {
        background-color: aliceblue;
    }

    .table {
        background-color: white;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
    }
</style>
<h1>Students</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Student</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClassCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Enrollments)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(model => item.ClassCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateOfBirth)
            </td>
            <td>
                    
                    @if (item.Enrollments != null && item.Enrollments.Any())
                    {
                        <ul>
                            @foreach (var enrollment in item.Enrollments)
                            {
                                <li>@enrollment.CourseName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>No Enrollments</span>
                    }
                    
            </td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                <span>
                    <a asp-action="Edit" asp-route-id="@item.StudentId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.StudentId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.StudentId">Delete</a>
                    <a asp-controller="Attendances" asp-action="Create" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-warning">Attendances</a>
                    <a asp-controller="Results" asp-action="Create" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-info">Results</a>
                </span>
                }
            </td>
        </tr>
}
    </tbody>
</table>
