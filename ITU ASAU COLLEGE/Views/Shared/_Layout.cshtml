@using Microsoft.AspNetCore.Identity
@using ITU_ASAU_COLLEGE.Data
@using ITU_ASAU_COLLEGE.Models
@inject UserManager<IdentityUser> UserManager
@inject ITU_ASAU_COLLEGEContext DbContext
@using ITU_ASAU_COLLEGE.Areas.Identity.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITU_ASAU_COLLEGE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITU_ASAU_COLLEGE.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
  <header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-navbar border-bottom box-shadow mb-3 sticky-navbar">
         <div class="container-fluid">
            <img src="~/images/IAClogo.png"
                 alt="Logo"
                 width="60"
                 height="60"
                 class="rounded-circle me-2" />
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ITU ASAU COLLEGE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
              
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="Notices" asp-action="Index">Notices</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="EnrollmentApplications" asp-action="Apply">Apply</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="AboutUs" asp-action="Index">About Us</a>
                    </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown user-profile">

                            <a class="nav-link dropdown-toggle d-flex align-items-center"
                               href="#"
                               id="userProfileDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <!-- Profile picture -->
                                <span class="profile-icon">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                <!-- Logged-in user's name -->
                                @{
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    string displayName = "";

                                    if (currentUser != null)
                                    {
                                        if (User.IsInRole("Student"))
                                        {
                                            var student = DbContext.Student
                                                .FirstOrDefault(s => s.Email == currentUser.Email);

                                            if (student != null)
                                            {
                                                displayName = $"{student.FirstName} {student.LastName}";
                                            }
                                        }
                                        else if (User.IsInRole("Teacher"))
                                        {
                                            var teacher = DbContext.Teacher
                                                .FirstOrDefault(t => 
                                                    t.LastName != null &&
                                                    currentUser.Email != null &&
                                                    currentUser.Email.ToLower() == 
                                                        $"dr.{t.LastName.ToLower()}@IAC.edu.ws");

                                            if (teacher != null)
                                            {
                                                displayName = $"{teacher.FirstName} {teacher.LastName}";
                                            }
                                        }
                                        else if (User.IsInRole("Admin"))
                                        {
                                            displayName = "Administrator";
                                        }

                                        // Fallback if a name could not be found
                                        if (string.IsNullOrWhiteSpace(displayName))
                                        {
                                            displayName = currentUser.Email ?? "User";
                                        }
                                    }
                                }

                                <span class="user-name">
                                    @displayName
                                </span>
                                
                            </a>

                            <!-- Dropdown -->
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown"
                                aria-labelledby="userProfileDropdown">

                                <li>
                                    <a class="dropdown-item user-setting"
                                       asp-area="Identity"
                                       asp-page="/Account/Manage/Index">

                                        <i class="bi bi-person-gear"></i>

                                        <span>User Settings</span>

                                    </a>
                                </li>

                                <li>
                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home")"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item logout-item">

                                            <i class="bi bi-box-arrow-right"></i>

                                            <span>Log Out</span>

                                        </button>

                                    </form>
                                </li>

                            </ul>
                        </li>
                    }
                    else
                    {
                        @await Html.PartialAsync("_LoginPartial")
                    }
                </div>
         </div>
       
    </nav>
  </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</html>
<footer class="border-bottom footer text-muted">
        <div class="footer-container">
        <div class="footer-section">
            <img src="~/images/IAClogo.png" alt="Logo" class="footer-logo" />
            <h4>ITU ASAU COLLEGE</h4>
            <p>Empowering students through quality education and excellence.</p>
            <style>
                .h4 {
                    color:blue
                }
            </style>
        </div>

        <div class="footer-section">
            <h4>Contact Us</h4>
            <p>📍 Fa'ananu Road, Matavai, Vaisigano, Savaii, Samoa</p>
            <p>📞 +685 7736778</p>
            <p>✉ info@ituasaucollege.edu.ws</p>
            <p> © 2026 ITU ASAU COLLEGE. All Rights Reserved.</p>
            <style>
                .h4 {
                    color:blue
                }
            </style>
        </div>

        <div class="footer-section">
            <h4>Quick Links</h4>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Students" asp-action="Index">Students</a></li>
                <li><a asp-controller="Notices" asp-action="Index">Notices</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
            </ul>
        </div>

    </div>

    <div class="footer-bottom">
        © 2026 ITU ASAU COLLEGE. All Rights Reserved.
    </div>

</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
  