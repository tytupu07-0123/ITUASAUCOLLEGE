<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITU_ASAU_COLLEGE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITU_ASAU_COLLEGE.styles.css" asp-append-version="true" />
</head>
    <header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-navbar border-bottom box-shadow mb-3 sticky-navbar">
            <div class="container-fluid">
            <img src="~/images/IAClogo.png"
                 alt="Logo"
                 width="60"
                 height="60"
                 class="rounded-circle me-2" />
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ITU ASAU COLLEGE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="AboutUs" asp-action="Index">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-blue" asp-area="" asp-controller="Notices" asp-action="Index">Notices</a>
                    </li>
                    </ul>
                    <partial name="_LoginPartial" />    
                </div>
            
            
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</html>
<footer class="border-bottom footer text-muted">
        <div class="footer-container">
        <div class="footer-section">
            <img src="~/images/IAClogo.png" alt="Logo" class="footer-logo" />
            <h4>ITU ASAU COLLEGE</h4>
            <p>Empowering students through quality education and excellence.</p>
            <style>
                .h4 {
                    color:blue
                }
            </style>
        </div>

        <div class="footer-section">
            <h4>Contact Us</h4>
            <p>📍 Fa'ananu Road, Matavai, Vaisigano, Savaii, Samoa</p>
            <p>📞 +685 7736778</p>
            <p>✉ info@ituasaucollege.edu.ws</p>
            <p> © 2026 ITU ASAU COLLEGE. All Rights Reserved.</p>
            <style>
                .h4 {
                    color:blue
                }
            </style>
        </div>

        <div class="footer-section">
            <h4>Quick Links</h4>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Students" asp-action="Index">Students</a></li>
                <li><a asp-controller="Notices" asp-action="Index">Notices</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
            </ul>
        </div>

    </div>

    <div class="footer-bottom">
        © 2026 ITU ASAU COLLEGE. All Rights Reserved.
    </div>

</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
  