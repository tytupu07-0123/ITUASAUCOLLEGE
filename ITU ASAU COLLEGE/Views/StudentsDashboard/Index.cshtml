@model ITU_ASAU_COLLEGE.Models.Student
@{
    ViewData["Title"] = "Students Dashboard";
}
<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h1>Students Dashboard</h1>
        <h2>Welcome, @Model.FirstName @Model.LastName</h2>
    </div>

    <div class="card shadow p-5">
        <div class="card-header">
            <h4>My Information</h4>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Student ID:</strong> @Model.StudentId</p>
            <p><strong>First Name:</strong> @Model.FirstName</p>
            <p><strong>Last Name:</strong> @Model.LastName</p>
            <p><strong>Date of Birth:</strong> @Model.DateOfBirth</p>
            <p><strong>Gender:</strong> @Model.Gender</p>
        </div>
    </div>
   
    <a asp-controller="StudentRecords"
   asp-action="MyAttendance"
   class="dashboard-card">

    <div class="dashboard-card-icon">📅</div>

    <div>
        <h3>My Attendance</h3>
        <p>View your attendance history.</p>
    </div>

</a>
<a asp-controller="StudentRecords"
   asp-action="MyResults"
   class="dashboard-card">

    <div class="dashboard-card-icon">📊</div>

    <div>
        <h3>My Results</h3>
        <p>View your academic results and grades.</p>
    </div>

</a>
</div>
<style>
    .h1 {
        color: #2c3e50;
        font-family: Arial, sans-serif;
        accent-color: #2980b9;
        font-size: 36px;
    }

    .h2 {
        color: #34495e;
        font-family: Arial, sans-serif;
        font-size: abs()
    }

</style>