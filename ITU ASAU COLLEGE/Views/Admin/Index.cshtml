                    <a href="@Url.Action("Index", "Attendances")" class="btn btn-primary">Go to Attendances</a>
                </div>
            </div>
        </div>
<div class="col-md-4">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Manage Courses</h5>
            <p class="card-text">Add, edit, or remove course records.</p>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-primary">Go to Courses</a>
        </div>
    </div>
</div>
<div class="col-md-4">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
