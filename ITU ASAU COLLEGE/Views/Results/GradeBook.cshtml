@model ITU_ASAU_COLLEGE.ViewModels.ResultGradebookViewModel

@{
    ViewData["Title"] = "Student Results";
}

<link rel="stylesheet" href="~/css/gradebook.css" />

<div class="gradebook-page">

    <!-- Page Header -->
    <div class="gradebook-header">
        <div>
            <h1>Student Results</h1>
            <p>Record and manage student academic results.</p>
        </div>

        <a asp-controller="TeachersDashboard"
           asp-action="Index"
           class="back-button">
            ← Back to Dashboard
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            <span>✓</span>
            <div>
                <strong>Success</strong>
                <p>@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <!-- Validation Errors -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">
            <strong>Please check the following:</strong>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- Selection Card -->
    <div class="selection-card">

        <div class="card-title">
            <div class="title-icon">📊</div>
            <div>
                <h2>Assessment Details</h2>
                <p>Select the class and assessment you want to record.</p>
            </div>
        </div>

        <form asp-action="Gradebook" method="get">

            <div class="selection-grid">

                <!-- Class -->
                <div class="form-group">
                    <label asp-for="ClassName">Class</label>

                    <select asp-for="ClassName" class="form-control">
                        <option value="">Select Class</option>
                        <option value="Yr9">Yr 9</option>
                        <option value="Yr10">Yr 10</option>
                        <option value="Yr11">Yr 11</option>
                        <option value="Yr12">Yr 12</option>
                    </select>

                    <span asp-validation-for="ClassName"
                          class="validation-text"></span>
                </div>

                <!-- Subject -->
                <div class="form-group">
                    <label asp-for="Subject">Subject</label>

                    <select asp-for="Subject" class="form-control">
                        <option value="">Select Subject</option>
                        <option value="English">English</option>
                        <option value="Mathematics">Mathematics</option>
                        <option value="Science">Science</option>
                        <option value="Social Studies">Social Studies</option>
                        <option value="Business Studies">Business Studies</option>
                        <option value="Economics">Economics</option>
                        <option value="Accounting">Accounting</option>
                        <option value="Computer Studies">Computer Studies</option>
                        <option value="Physical Education">Physical Education</option>
                        <option value="Samoan">Samoan</option>
                    </select>

                    <span asp-validation-for="Subject"
                          class="validation-text"></span>
                </div>

                <!-- Assessment Type -->
                <div class="form-group">
                    <label asp-for="AssessmentType">Assessment Type</label>

                    <select asp-for="AssessmentType" class="form-control">
                        <option value="">Select Assessment</option>
                        <option value="Test">Test</option>
                        <option value="Assignment">Assignment</option>
                        <option value="Project">Project</option>
                        <option value="Exam">Exam</option>
                        <option value="Presentation">Presentation</option>
                        <option value="Practical">Practical</option>
                    </select>

                    <span asp-validation-for="AssessmentType"
                          class="validation-text"></span>
                </div>

                <!-- Date -->
                <div class="form-group">
                    <label asp-for="Date">Date</label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Date"
                          class="validation-text"></span>
                </div>

            </div>

            <div class="selection-actions">
                <button type="submit" class="load-button">
                    <span>🔍</span>
                    Load Students
                </button>
            </div>

        </form>
    </div>


    <!-- Students Gradebook -->
    @if (Model.Students != null && Model.Students.Count > 0)
    {
        <div class="results-card">

            <div class="results-card-header">

                <div>
                    <h2>Student Marks</h2>

                    <p>
                        <strong>@Model.ClassName</strong>
                        <span>•</span>
                        @Model.Subject
                        <span>•</span>
                        @Model.AssessmentType
                    </p>
                </div>

                <div class="student-count">
                    <span>@Model.Students.Count</span>
                    Students
                </div>

            </div>


            <form asp-action="Gradebook"
                  method="post"
                  id="resultsForm">

                @Html.AntiForgeryToken()

                <!-- Keep assessment information -->
                <input type="hidden"
                       asp-for="ClassName" />

                <input type="hidden"
                       asp-for="Subject" />

                <input type="hidden"
                       asp-for="AssessmentType" />

                <input type="hidden"
                       asp-for="Date" />


                <div class="table-container">

                    <table class="gradebook-table">

                        <thead>
                            <tr>
                                <th class="number-column">#</th>
                                <th>Student Name</th>
                                <th class="mark-column">Mark / 100</th>
                                <th class="grade-column">Grade</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>

                                    <td class="student-number">
                                        @(i + 1)
                                    </td>

                                    <td>
                                        <div class="student-name">
                                            <div class="student-avatar">
                                                @Model.Students[i].StudentName.Substring(0, 1).ToUpper()
                                            </div>

                                            <span>
                                                @Model.Students[i].StudentName
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="hidden"
                                               asp-for="Students[i].StudentId" />

                                        <input type="hidden"
                                               asp-for="Students[i].StudentName" />

                                        <input asp-for="Students[i].Mark"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               class="mark-input"
                                               placeholder="Enter mark"
                                               oninput="updateGrade(this)" />
                                    </td>

                                    <td>
                                        <span class="grade-display"
                                              data-grade-for="@i">
                                            @(Model.Students[i].Grade ?? "—")
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- Grade Information -->
                <div class="grading-info">

                    <div class="grading-title">
                        <span>ℹ</span>
                        Grade Scale
                    </div>

                    <div class="grade-scale">

                        <div>
                            <strong>A</strong>
                            <span>80–100</span>
                        </div>

                        <div>
                            <strong>B</strong>
                            <span>70–79</span>
                        </div>

                        <div>
                            <strong>C</strong>
                            <span>60–69</span>
                        </div>

                        <div>
                            <strong>D</strong>
                            <span>50–59</span>
                        </div>

                        <div>
                            <strong>E</strong>
                            <span>0–49</span>
                        </div>

                    </div>

                </div>


                <!-- Bottom Actions -->
                <div class="results-actions">

                    <button type="button"
                            class="clear-button"
                            onclick="clearMarks()">
                        Clear Marks
                    </button>

                    <button type="submit"
                            class="save-button">
                        <span>✓</span>
                        Save Results
                    </button>

                </div>

            </form>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.ClassName))
    {
        <div class="empty-state">

            <div class="empty-icon">
                👨‍🎓
            </div>

            <h2>No Students Found</h2>

            <p>
                There are currently no students registered in
                <strong>@Model.ClassName</strong>.
            </p>

        </div>
    }
    else
    {
        <div class="instructions-card">

            <div class="instructions-icon">
                📚
            </div>

            <h2>Start Recording Results</h2>

            <p>
                Select a class, subject, assessment type and date above,
                then click <strong>Load Students</strong> to begin.
            </p>

        </div>
    }

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        // Automatically calculate the grade when a mark is entered
        function updateGrade(input) {

            const row = input.closest("tr");
            const gradeDisplay = row.querySelector(".grade-display");

            const mark = parseFloat(input.value);

            if (isNaN(mark)) {
                gradeDisplay.textContent = "—";
                return;
            }

            if (mark < 0 || mark > 100) {
                gradeDisplay.textContent = "Invalid";
                return;
            }

            let grade;

            if (mark >= 80) {
                grade = "A";
            }
            else if (mark >= 70) {
                grade = "B";
            }
            else if (mark >= 60) {
                grade = "C";
            }
            else if (mark >= 50) {
                grade = "D";
            }
            else {
                grade = "E";
            }

            gradeDisplay.textContent = grade;
        }


        // Calculate grades for marks that were already loaded
        document.addEventListener("DOMContentLoaded", function () {

            const markInputs =
                document.querySelectorAll(".mark-input");

            markInputs.forEach(function (input) {

                if (input.value !== "") {
                    updateGrade(input);
                }

            });

        });


        // Clear all marks
        function clearMarks() {

            const inputs =
                document.querySelectorAll(".mark-input");

            inputs.forEach(function (input) {
                input.value = "";
                updateGrade(input);
            });

        }

    </script>
}